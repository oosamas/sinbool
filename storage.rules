rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Pre-generated audio narrations - public read, no client writes
    match /audio/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
